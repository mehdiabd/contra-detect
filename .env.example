# Elasticsearch (set ES_ENABLED=true to fetch posts from the org index)
ES_ENABLED=false
ES_HOSTS=http://localhost:9200
ES_INDEX=posts
ES_USER=
ES_PASSWORD=
ES_API_KEY=

# Field mapping for the organization index
ES_FIELD_USER_ID=user_id
ES_FIELD_TEXT=text
ES_FIELD_PLATFORM=platform
ES_FIELD_TIMESTAMP=timestamp
ES_FIELD_POST_ID=post_id

# Optional override for a trained model directory
MODEL_DIR=
