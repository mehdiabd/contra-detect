# Same production cluster as echo_chamber elastic_client auth=1.
# Leave ES_API_KEY empty to use the echo_chamber production key.
ES_ENABLED=true
ELASTIC_AUTH=1
ES_HOSTS=https://elastic.synappse.ir
ES_API_KEY=
ES_USER=
ES_PASSWORD=
ES_VERIFY_CERTS=true
ES_START_DATE=
ES_END_DATE=
ES_MAX_POSTS_PER_USER=40

# Comma-separated indexes per platform. Set to none/off to disable a source.
ES_INDEX=twitter_temp_data
ES_INDEX_TWITTER=twitter_temp_data
ES_INDEX_TELEGRAM=telegram_temp_data,telegram_source,telegram_comment_data
ES_INDEX_INSTAGRAM=instagram_temp_data,instagram_source,instagram_comment_data

# Shared field mapping (override per platform with ES_<PLATFORM>_FIELD_*)
ES_FIELD_USER_ID=user_name
ES_FIELD_TEXT=normalized_text
ES_FIELD_TIMESTAMP=date
ES_FIELD_POST_ID=post_id
ES_FIELD_PLATFORM=platform
ES_REFERENCE_TYPES=post,tweet,original

# Optional per-platform field overrides
# ES_TELEGRAM_FIELD_USER_ID=user_name
# ES_TELEGRAM_FIELD_TEXT=normalized_text
# ES_INSTAGRAM_FIELD_USER_ID=user_name
# ES_INSTAGRAM_FIELD_TEXT=normalized_text

MODEL_DIR=
FALLBACK_MODEL=persiannlp/parsbert-base-parsinlu-entailment
